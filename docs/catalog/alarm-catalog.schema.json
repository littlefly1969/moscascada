{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/littlefly1969/moscascada/docs/catalog/alarm-catalog.schema.json",
  "title": "MoscaSCADA Alarm Catalog (VS-005, catalog_schema_version 1)",
  "description": "Operator metadata of alarms. EXTERNAL to the kernel: never loaded into the hot path, never in the state digest. alarm_id is the stable foreign key to [[alarms.rules]] id.",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog_schema_version", "catalog_version", "config_fingerprint", "languages", "alarms"],
  "properties": {
    "catalog_schema_version": { "const": 1 },
    "catalog_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "config_fingerprint": {
      "description": "Hex fingerprint (scada-kernel --check-config) of the configuration the catalog was written for; a mismatch is a warning for the HMI, not a kernel error.",
      "type": "string", "pattern": "^([0-9a-f]{64}|unbound)$"
    },
    "languages": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/lang" } },
    "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } },
    "graphics": { "type": "array", "items": { "$ref": "#/$defs/graphic" } },
    "documents": { "type": "array", "items": { "$ref": "#/$defs/document" } },
    "alarms": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "lang": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" },
    "text": {
      "description": "Multilingual text: language -> string.",
      "type": "object", "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/lang" },
      "additionalProperties": { "type": "string", "maxLength": 4096 }
    },
    "asset": {
      "type": "object", "additionalProperties": false, "required": ["asset_id", "title"],
      "properties": { "asset_id": { "$ref": "#/$defs/id" }, "title": { "$ref": "#/$defs/text" }, "parent_asset_id": { "$ref": "#/$defs/id" } }
    },
    "graphic": {
      "type": "object", "additionalProperties": false, "required": ["graphic_id", "title"],
      "properties": { "graphic_id": { "$ref": "#/$defs/id" }, "title": { "$ref": "#/$defs/text" } }
    },
    "document": {
      "type": "object", "additionalProperties": false, "required": ["document_id", "title", "uri"],
      "properties": {
        "document_id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "uri": { "type": "string", "maxLength": 2048, "description": "Resolved by the HMI/catalog service, never by the kernel." },
        "kind": { "enum": ["procedure", "manual", "drawing", "datasheet", "other"] }
      }
    },
    "graphic_ref": {
      "description": "AlarmGraphicRef { graphic_id, element_id: Option, action: Open | OpenAndHighlight }",
      "type": "object", "additionalProperties": false, "required": ["graphic_id", "action"],
      "properties": {
        "graphic_id": { "$ref": "#/$defs/id" },
        "element_id": { "$ref": "#/$defs/id" },
        "action": { "enum": ["Open", "OpenAndHighlight"] }
      }
    },
    "entry": {
      "description": "AlarmCatalogEntry. Severity, tag binding and thresholds are NOT here: they belong to the kernel configuration.",
      "type": "object", "additionalProperties": false, "required": ["alarm_id", "title"],
      "properties": {
        "alarm_id": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "title": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/text" },
        "operator_instructions": { "$ref": "#/$defs/text" },
        "causes": { "type": "array", "items": { "$ref": "#/$defs/text" } },
        "suggestions": { "type": "array", "items": { "$ref": "#/$defs/text" } },
        "related_tag_ids": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 1, "maximum": 4294967295 } },
        "asset_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "document_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "graphics": { "type": "array", "items": { "$ref": "#/$defs/graphic_ref" } }
      }
    }
  }
}
